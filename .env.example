# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Band booking form (app/api/booking/route.ts)
RESEND_API_KEY=
BOOKING_EMAIL_TO=
# Optional; defaults to Resend's test sender
BOOKING_EMAIL_FROM=

# Login / sessions (lib/auth.ts, app/api/auth/*)
# AUTH_SECRET must be at least 32 characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: direct Postgres connection for running SQL from the terminal
# (Supabase -> Connect -> Direct connection). Not used by the site.
SUPABASE_DB_URL=
